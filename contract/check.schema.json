{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "jira-flow/check",
  "title": "Project check",
  "description": "A Jira project against a template: items carry codes and variables, not phrases; describe(result, lang) adds text.",
  "type": "object",
  "required": ["project", "template", "items", "ok", "warn", "bad", "unknown"],
  "properties": {
    "project": { "type": "string", "maxLength": 10 },
    "template": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": { "id": { "type": "string", "maxLength": 40 }, "version": { "type": "integer" } }
    },
    "items": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "required": ["key", "state", "code", "vars", "fix"],
        "properties": {
          "key": { "enum": ["kind", "statuses", "categories", "transitions", "initial", "board", "types", "issues", "rules"] },
          "state": { "enum": ["ok", "warn", "bad", "unknown"] },
          "code": { "type": "string", "maxLength": 60 },
          "vars": { "type": "object" },
          "fix": {
            "oneOf": [
              { "type": "null" },
              { "type": "object", "required": ["code"], "properties": { "code": { "type": "string", "maxLength": 60 }, "vars": { "type": "object" } } }
            ]
          }
        }
      }
    },
    "ok": { "type": "integer", "minimum": 0 },
    "warn": { "type": "integer", "minimum": 0 },
    "bad": { "type": "integer", "minimum": 0 },
    "unknown": { "type": "integer", "minimum": 0 },
    "plan": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "required": ["key", "code", "vars", "via"],
        "properties": { "key": { "type": "string" }, "code": { "type": "string" }, "vars": { "type": "object" }, "via": { "enum": ["api", "manual", "check"] } }
      }
    }
  }
}
