{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "jira-flow/template",
  "title": "Workflow template",
  "description": "Statuses with categories, transitions, the initial status, board columns, issue types and roles. Texts for people live in locales under template.<id>.*.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "version", "statuses", "initial", "transitions", "columns", "types", "roles"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,40}$" },
    "version": { "type": "integer", "minimum": 1, "maximum": 1000 },
    "statuses": {
      "type": "array",
      "minItems": 1,
      "maxItems": 40,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "category"],
        "properties": {
          "name": { "type": "string", "minLength": 1, "maxLength": 60 },
          "category": { "enum": ["new", "indeterminate", "done"] },
          "phase": { "enum": ["design", "dev", null] }
        }
      }
    },
    "initial": { "type": "string", "minLength": 1, "maxLength": 60 },
    "transitions": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from", "to"],
        "properties": {
          "from": { "type": "string", "minLength": 1, "maxLength": 60, "description": "a status name or * for any status" },
          "to": { "type": "string", "minLength": 1, "maxLength": 60 }
        }
      }
    },
    "columns": { "type": "array", "maxItems": 40, "items": { "type": "string", "minLength": 1, "maxLength": 60 } },
    "types": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "required"],
        "properties": { "name": { "type": "string", "minLength": 1, "maxLength": 60 }, "required": { "type": "boolean" } }
      }
    },
    "roles": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "statuses", "gate"],
        "properties": {
          "key": { "enum": ["design", "lead", "dev", "qa"] },
          "statuses": { "type": "array", "maxItems": 40, "items": { "type": "string", "maxLength": 60 } },
          "gate": { "type": "array", "maxItems": 40, "items": { "type": "string", "maxLength": 60 } }
        }
      }
    }
  }
}
