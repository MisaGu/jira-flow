{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "jira-flow/item",
  "title": "Sync item",
  "description": "What the host pushes to the sync engine: one item — one issue.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "summary", "status"],
  "properties": {
    "id": { "type": "string", "minLength": 1, "maxLength": 500, "description": "the host's stable key of the item" },
    "summary": { "type": "string", "minLength": 1, "maxLength": 255, "x-lang": true },
    "body": { "type": "string", "maxLength": 30000, "description": "markdown; Jira gets ADF", "x-lang": true },
    "status": { "type": "string", "minLength": 1, "maxLength": 60, "description": "a template status the issue should be in now" },
    "notes": {
      "type": "array",
      "maxItems": 200,
      "description": "things that happened; each id is commented once",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "text"],
        "properties": { "id": { "type": "string", "minLength": 1, "maxLength": 200 }, "text": { "type": "string", "minLength": 1, "maxLength": 10000, "x-lang": true } }
      }
    }
  }
}
