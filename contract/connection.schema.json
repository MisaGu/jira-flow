{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "jira-flow/connection",
  "title": "Jira connection",
  "description": "What createClient takes. The token stays in the Authorization header only.",
  "type": "object",
  "additionalProperties": false,
  "required": ["site", "email", "token"],
  "properties": {
    "site": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}\\.(atlassian\\.net|jira\\.com)$" },
    "email": { "type": "string", "minLength": 3, "maxLength": 254 },
    "token": { "type": "string", "minLength": 1, "maxLength": 4000 }
  }
}
