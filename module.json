{
  "name": "jira-flow",
  "version": "0.1.3",
  "contract": 2,
  "what": "Workflow templates for Jira Cloud team-managed projects (check, plan, apply in one go, roles, new project) and keeping issues in step with the host's items.",
  "entry": "main.mjs",
  "env": "JIRA_FLOW",
  "model": false,
  "api": [
    "addComment", "applyTemplate", "arrangeColumns", "blockedFor", "boardOps", "boardUrl", "buildUpdate", "checkLang", "checkProject", "CONTRACT",
    "createClient", "createFromTemplate", "createIssue", "createProject", "createSync", "describe", "describeTemplate", "enums",
    "findByLabel", "FlowError", "inspect", "isAdmin", "issueUrl", "ISSUE_KEY_RE", "KEY_RE", "labels", "listProjects", "loadTemplate", "markdownToAdf",
    "moveTo", "pathTo", "planColumns", "planFor", "readColumns", "readIssue", "readPeople", "readProject", "retryable", "roleOf", "rolesFor",
    "rulesFor", "rulesItem", "schemas", "setParent", "setText", "siteCloudId", "SITE_RE", "statusOf", "TEMPLATE_IDS", "textOf", "validateTemplate",
    "VERSION", "wantedOrder"
  ],
  "commands": ["check", "apply", "people", "projects", "create", "template", "labels", "help"],
  "schemas": {
    "connection": "contract/connection.schema.json",
    "template": "contract/template.schema.json",
    "check": "contract/check.schema.json",
    "item": "contract/item.schema.json"
  },
  "needs": ["Jira Cloud site", "Atlassian API token of a person"]
}
